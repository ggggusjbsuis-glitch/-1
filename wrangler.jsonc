{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1",
  "main": "worker.js",
  "compatibility_date": "2026-06-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "SCHEDULE_KV",
      "id": "d1e23fee9a27438b95a9305b47444e81"
    }
  ],
  "vars": {
    "ADMIN_PASSWORD": "admin123"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
